<mjml>
  <mj-head>
    <mj-title>TaskCurrent Early Access Product Introduction</mj-title>
    <mj-preview>TaskCurrent Early Access Product Introduction</mj-preview>
    <mj-include path="./styles.mjml" />
    <mj-style>
      @media (max-width: 479px) {
        td.cta { text-align: center !important; }
        td.cta > table { margin: 0 auto !important; }
      }
    </mj-style>
  </mj-head>z

  <mj-body css-class="page" background-color="#eef2f5">
    <!-- 2. Pull in your Reusable Header -->
    <mj-include path="./components/header/header.mjml" />

    <!-- 3. Main Email Body Content -->
    <mj-wrapper mj-class="card">
      <!-- Pill element -->
      <mj-section mj-class="body-section" padding="24px 24px 0" text-align="left">
        <mj-column width="100%">
          <mj-text mj-class="eyebrow-text" color="#5267FF" padding="0">
            Early access · What’s possible
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px 0">
        <mj-column width="100%">
          <mj-text mj-class="headline" padding="0">
            What TaskCurrent can automate for you
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px">
        <mj-column width="100%">
          <mj-text mj-class="body-text greeting" padding="0 0 16px">Hi <span class="var">There</span>,</mj-text>
          <mj-text mj-class="body-text" padding="0 0 16px">Here are a few examples of repetitive work you can take off your team’s plate — each one starts with an everyday event and ends with the right next step.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="8px 24px">
        <mj-column mj-class="steps-panel" width="100%">
          <mj-text mj-class="steps-section" padding="0 0 16px">01</mj-text>
          <mj-text mj-class="steps-heading step-header" padding="0 0 8px">Lead follow-up</mj-text>
          <mj-text mj-class="steps-body" padding="0 0 16px">Respond to new inquiries quickly and make sure every lead gets the right next step.</mj-text>
          <mj-text>
           <picture>
              <source srcset="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/lead_followup_workflow2x_mobile.png" media="(max-width: 480px)">
              <img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/lead_followup_workflow2x.png" alt="lead followup workflow infographc" width="150" style="display:block;width:470px;max-width:100%;height:auto;border:0;">
          </picture>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="body-section" padding="8px 24px">
        <mj-column mj-class="steps-panel" width="100%">
          <mj-text mj-class="steps-section" padding="0 0 16px">02</mj-text>
          <mj-text mj-class="steps-heading step-header" padding="0 0 8px">Appointment reminders</mj-text>
          <mj-text mj-class="steps-body" padding="0 0 16px">Keep customers and staff informed without relying on someone to remember every follow-up.</mj-text>
          <mj-text>
           <picture>
              <source srcset="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/appointment_reminders_workflow2x_mobile.png" media="(max-width: 480px)">
              <img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/appointment_reminders_workflow2x.png" alt="appointment reminders infographc" width="150" style="display:block;width:470px;max-width:100%;height:auto;border:0;">
          </picture>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section mj-class="body-section" padding="8px 24px">
        <mj-column mj-class="steps-panel" width="100%">
          <mj-text mj-class="steps-section" padding="0 0 16px">03</mj-text>
          <mj-text mj-class="steps-heading step-header" padding="0 0 8px">Customer onboarding</mj-text>
          <mj-text mj-class="steps-body" padding="0 0 16px">Trigger the right onboarding steps as soon as a customer is ready to get started.</mj-text>
          <mj-text>
           <picture>
              <source srcset="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/customer_onboarding_workflow2x_mobile.png" media="(max-width: 480px)">
              <img src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791393544/appointment_reminders_workflow2x.png" alt="customer onboarding infographc" width="150" style="display:block;width:470px;max-width:100%;height:auto;border:0;">
          </picture>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- CTAs: columns stack on mobile -->
      <mj-section mj-class="body-section" padding="24px 24px 8px" text-align="left">
        <mj-column width="308px" padding-bottom="8px">
          <mj-button mj-class="btn-primary" align="left" padding="0" css-class="cta" href="https://taskcurrent.vercel.app/early-access?utm_source=taskcurrent&amp;utm_medium=email&amp;utm_campaign=saas_taskcurrent&amp;utm_content=see_how_taskcurrent_works">See How TaskCurrent Works</mj-button>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px 24px">
        <mj-column width="100%">
          <mj-text mj-class="body-text" padding="0 0 4px">Talk soon,</mj-text>
          <mj-text mj-class="body-text" padding="0">The TaskCurrent team</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- 4. Pull in your Reusable Footer -->
    <mj-include path="./components/footer/footer.mjml" />
  </mj-body>
</mjml>
