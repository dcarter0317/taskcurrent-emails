<mjml>
  <mj-head>
    <mj-title>TaskCurrent Demo Request Confirmation</mj-title>
    <mj-preview>TaskCurrent Demo Request Confirmation</mj-preview>
    <mj-include path="./styles.mjml" />
    <mj-style>
      @media (max-width: 479px) {
        td.cta { text-align: center !important; }
        td.cta > table { margin: 0 auto !important; }
      }
    </mj-style>
  </mj-head>

  <mj-body css-class="page" background-color="#eef2f5">
    <!-- 2. Pull in your Reusable Header -->
    <mj-include path="./components/header/header.mjml" />

    <!-- 3. Main Email Body Content -->
    <mj-wrapper mj-class="card">
      <!-- Pill element -->
      <mj-section mj-class="body-section" padding="24px 24px 0" text-align="left">
        <mj-column width="100%">
          <mj-text mj-class="pill-text" padding="0">
            <span class="pill" ><img class="pill-icon" src="https://res.cloudinary.com/wm6ofka9/image/upload/v1791765335/Icon_check_brand2x.png" width="16" height="16" alt="" />Request received</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px 0">
        <mj-column width="100%">
          <mj-text mj-class="headline" padding="0">
            We received your demo request.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px">
        <mj-column width="100%">
          <mj-text mj-class="body-text greeting" padding="0 0 16px">Hi <span class="var">There</span>,</mj-text>
          <mj-text mj-class="body-text" padding="0 0 16px">Thanks for requesting a TaskCurrent demo.</mj-text>
          <mj-text mj-class="body-text" padding="0 0 16px">We’ll use the time to learn a little about your current workflow and show where TaskCurrent could remove repetitive steps.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="8px 24px">
        <mj-column mj-class="steps-panel" width="100%">
          <mj-text mj-class="steps-heading" text-transform="uppercase" font-weight="600" padding="0 0 16px">What we’ll cover</mj-text>
          <mj-table padding="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td width="40" valign="middle" style="width:40px;padding:0 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-num">01</div>
              </td>
              <td valign="middle" style="padding:0 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-title">Your current process</div>
              </td>
            </tr>
            <tr>
              <td width="40" valign="middle" style="width:40px;padding:16px 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-num">02</div>
              </td>
              <td valign="middle" style="padding:16px 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-title">Where automation could save time</div>
              </td>
            </tr>
            <tr>
              <td width="40" valign="middle" style="width:40px;padding:16px 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-num">03</div>
              </td>
              <td valign="middle" style="padding:16px 0 16px 0;border-bottom:1px solid #E4E7EC;">
                <div class="step-title">How TaskCurrent workflows are built</div>
              </td>
            </tr>
            <tr>
              <td width="40" valign="middle" style="width:40px;padding:16px 0 0 0;">
                <div class="step-num">04</div>
              </td>
              <td valign="middle" style="padding:16px 0 0 0;">
                <div class="step-title">How tracking and reporting work</div>
              </td>
            </tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column width="100%">
           <mj-text mj-class="body-text">
            Someone from our team will follow up by email to find a time that works for you. In the meantime, here’s a closer look at what TaskCurrent does.
           </mj-text>
        </mj-column>
      </mj-section>

      <!-- CTAs: columns stack on mobile -->
      <mj-section mj-class="body-section" padding="24px 24px 8px" text-align="left">
        <mj-column width="308px" padding-bottom="8px">
          <mj-button mj-class="btn-primary" align="left" padding="0" css-class="cta" href="https://taskcurrent.vercel.app/early-access?utm_source=taskcurrent&amp;utm_medium=email&amp;utm_campaign=saas_taskcurrent&amp;utm_content=explore_taskCurrent_features">Explore TaskCurrent Features</mj-button>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding="16px 24px 24px">
        <mj-column width="100%">
          <mj-text mj-class="body-text" padding="0 0 4px">Talk soon,</mj-text>
          <mj-text mj-class="body-text" padding="0">The TaskCurrent team</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <!-- 4. Pull in your Reusable Footer -->
    <mj-include path="./components/footer/footer.mjml" />
  </mj-body>
</mjml>
