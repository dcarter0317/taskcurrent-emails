<mjml>
<mj-head>
  <mj-font name="Geist Mono" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&amp;display=swap" />
  <mj-font name="Geist" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&amp;display=swap" />
  <mj-font name="Open Sans" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&amp;display=swap" />

    <!-- 1. Define your Global Styleguide Components -->
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: dark) {
        .card, .card > table, .card > div, .card > div > table, .card > div > table > tbody > tr > td { background-color: #151F35 !important; }
        .card, .card > table, .card > div, .card > div > table { background-color: transparent !important; }
        .card { overflow: visible !important; }
        body, .page, .page > div { background-color: #101828 !important; }
        .card { border-color: #22304D !important; }
        .body-text div { color: #98A2B3 !important; }
        .var, .brand-text, .btn-link a { color: #22D3EE !important; }
        .steps-panel, .steps-panel > table, .steps-panel > table > tbody > tr > td { background-color: #1B2745 !important; }
        .steps-col-divider > table > tbody > tr > td { border-color: #22304D !important; }
        .step-title, .schedule-title, .schedule-day { color: #F2F4F7 !important; }
        .step-meta, .schedule-meta { color: #98A2B3 !important; }
        .schedule-badge { background-color: #1B2745 !important; border-color: #22304D !important; }
        .pill { background-color: #1E2A4A !important; }
        .pill-success { background-color: #123B38 !important; color: #5EE0B0 !important; }
        .pill-upcoming { background-color: #3A2A12 !important; color: #F5B85C !important; }
        .card-text div { color: #F2F4F7 !important; }
        .step-header div, .steps-heading div, .steps-col-text div, .greeting div { color: #F2F4F7 !important; }
        .steps-body div, .steps-body { color: #98A2B3 !important; }
        .eyebrow-text, td.eyebrow-text { color: #98A2B3 !important; }
        .steps-section div, .step-num, .steps-label-brand div { color: #22D3EE !important; }
        .steps-label-cyan div, .cyan-text { color: #5EE0E0 !important; }
        .steps-label-violet div, .violet-text { color: #B7A6FF !important; }
        .steps-grid, .steps-grid > table, .steps-grid > div, .steps-grid > div > table, .steps-grid > div > table > tbody > tr > td { background-color: #151F35 !important; border-color: #22304D !important; }
        .steps-grid table { border-color: #22304D !important; }
        .steps-grid { overflow: visible !important; }
        .schedule-card, .schedule-card > table, .schedule-card > table > tbody > tr > td { background-color: #1B2745 !important; border-color: #22304D !important; }
        .steps-panel td[style*="border-bottom"] { border-bottom-color: #22304D !important; }
        .headline div, .subheading div { color: #F2F4F7 !important; }
        .hdr, .hdr > table, .hdr > div, .hdr > div > table, .hdr td,
        .ftr, .ftr > table, .ftr > div, .ftr > div > table, .ftr td { background-color: #101828 !important; }
        .hdr-link a, .hdr-link td { color: #98A2B3 !important; }
        .ftr-text div, .ftr-text { color: #98A2B3 !important; }
        .ftr-head div { color: #E4E9F0 !important; }
        .ftr-link, a.ftr-link, .ftr-link a, .ftr a.mj-link { color: #FFFFFF !important; background-color: transparent !important; }
        .ftr-hr p { border-top-color: #667085 !important; }
      }
    </mj-style>

    <!-- Inlined so classes survive clients that strip <style> (used inside raw HTML: pill, steps) -->
    <mj-style inline="inline">
      .cyan-text { color: #08677D; }
      .brand-text { color: #5267FF; }
      .violet-text { color: #6A4BE0; }
      .pill { display: inline-block; background-color: #EEF0FF; border-radius: 50px; padding: 8px 14px 8px 12px; }
      .pill-upcoming { background-color: #FEF3DC; color: #B54708; }
      .pill-success { background-color: #E1FBF2; color: #067647; }
      .pill-icon { vertical-align: middle; border: 0; margin-right: 6px; }
      .var { color: #5267FF; }
      .step-icon { padding: 0 12px 16px 0; }
      .step-copy { padding: 0 0 16px 0; }
      .step-last { padding-bottom: 0; }
      .step-title { font-size: 16px; line-height: 24px; color: #101828; }
      .step-num { font-size: 14px; line-height: 24px; font-weight: 600; color: #5267FF; }
      .step-meta { font-size: 12px; line-height: 20px; color: #667085; font-weight: 300; }
      .schedule-badge { width: 64px; border: 1px solid #E4E9F0; border-radius: 12px; border-collapse: separate; background-color: #ffffff; text-align: center; }
      .schedule-month { background-color: #5267FF; color: #ffffff; font-size: 11px; line-height: 16px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; text-align: center; padding: 3px 0; border-radius: 11px 11px 0 0; }
      .schedule-day { color: #101828; font-size: 24px; line-height: 32px; font-weight: 700; text-align: center; padding: 6px 0 8px; border-radius: 0 0 11px 11px; }
      .schedule-title { color: #101828; font-size: 18px; line-height: 26px; font-weight: 600; padding: 0 0 4px 0; }
      .schedule-meta { color: #667085; font-size: 14px; line-height: 22px; font-weight: 300; padding: 0; }
      .schedule-icon { width: 24px; line-height: 0; font-size: 0; vertical-align: middle; }
      .schedule-icon img { display: block; width: 14px; height: 22px; border: 0; }
      .three-col-grid-elem-img { padding-bottom: 8px; }
      .three-col-grid-elem-title { text-transform: uppercase; font-weight: 600; }
      .three-col-grid-elem-description { font-size: 15px; line-height: 22px; }
    </mj-style>

    <mj-attributes>
      <!-- Base elements reset -->
      <mj-all font-family="Geist, 'Open Sans', Helvetica, Arial, sans-serif" color="#667085" />
  
      
      <!-- Custom styleguide classes (mj-class) -->
      <mj-class name="color-brand" color="#5267FF" />
      <mj-class name="color-success" color="#067647" />
      <mj-class name="color-mint" color="#E1FBF2" />
      <mj-class name="bg-surface" background-color="#eef2f5" />
      <mj-class name="headline" css-class="headline" font-size="32px" line-height="40px" font-weight="600" color="#101828"  />
      <mj-class name="section-header" css-class="subheading" font-size="20px" line-height="28px" font-weight="500" />
      <mj-class name="eyebrow" font-size="12px" line-height="18px" font-weight="600" text-transform="uppercase" letter-spacing="0.8px" />
      <mj-class name="mono" font-family="'Geist Mono', Menlo, Consolas, monospace" />
      <mj-class name="header-elem" color="#101828" />
      <mj-class name="brand-text" font-weight="600" color="#007bff" letter-spacing="1px" />
      <mj-class name="footer-text" font-size="12px" color="#777777" line-height="16px" />
      <mj-class name="btn-primary" background-color="#5267FF" color="#ffffff" font-size="16px" line-height="16px" font-weight="600" border-radius="10px" border="1px solid #5267FF" inner-padding="12px 24px" />
      <mj-class name="btn-secondary" background-color="#ffffff" color="#101828" font-size="16px" line-height="16px" font-weight="600" border-radius="10px" border="1px solid #E4E9F0" inner-padding="12px 0" />
      <mj-class name="btn-tertiary" background-color="#ffffff" color="#101828" font-size="16px" line-height="16px" font-weight="600" border-radius="10px" border="none" inner-padding="12px 0" />
      <mj-class name="btn-link" css-class="btn-link" background-color="transparent" color="#5267FF" font-size="16px" line-height="16px" font-weight="600" border="none" inner-padding="12px 0" />
      <mj-class name="btn-icon" background-color="transparent" color="#5267FF" font-size="16px" line-height="16px" font-weight="600" border="none" inner-padding="12px 0" />
      <mj-class name="primary-link" align="right" font-size="13px" font-weight="400" color="#667085" background-color="transparent" text-decoration="underline" padding="0" inner-padding="12px 0" />
      <mj-class name="header-section" background-color="#F8FAFC" padding="16px 24px" />
      <mj-class name="header-logo" align="left" width="150px" padding="0" />
      <mj-class name="header-col" width="50%" vertical-align="middle" />
      <mj-class name="body-text" css-class="body-text" color="#667085" font-size="16px" line-height="26px" font-weight="200" />
      <mj-class name="card" css-class="card" background-color="#ffffff" border="1px solid #E4E9F0" border-radius="16px" padding="0" />
      <mj-class name="body-section" css-class="card" background-color="#ffffff" />
      <mj-class name="eyebrow-text" font-size="12px" line-height="18px" font-weight="600" text-transform="uppercase" />
      <mj-class name="pill-text" font-size="14px" line-height="16px" font-weight="600" color="#5267FF" />
      <mj-class name="greeting" color="#101828" font-weight="400" />
      <mj-class name="steps-panel" css-class="steps-panel" background-color="#F0F2F7" border-radius="8px" padding="20px" />
      <mj-class name="schedule-card" css-class="schedule-card" background-color="#ffffff" inner-border="1px solid #E4E9F0" inner-border-radius="12px" padding="0" />
      <mj-class name="step-header"font-size="19px" line-height="26px" font-weight="600" color="#101828" />
      <mj-class name="steps-heading" css-class="steps-heading" />
      <mj-class name="steps-body" css-class="steps-body" font-size="15px" line-height="24px"font-weight="300" color="#667085" />
      <mj-class name="steps-section" font-size="12px" line-height="16px" font-weight="600" text-transform="uppercase" letter-spacing="0.8px" color="#5267FF" />
      <mj-class name="footer-section" background-color="#F8FAFC" padding="24px 12px" color="#98A2B3" />
      <mj-class name="footer-header" font-size="15px" color="#101828" font-weight="600" text-transform="capitalize" padding-bottom="5px" />
      <mj-class name="footer-body" font-size="13px" line-height="20px" font-weight="200" color="#667085" />
      <mj-class name="footer-link" color="#101828" font-size="14px" text-decoration="underline" line-height="20px" text-transform="capitalize" font-weight="300" padding="0 16px 0 0" />   
      <mj-class name="footer-hr" border-color="#cccccc" border-style="solid" border-width="1px" padding-top="20px" padding-bottom="20px" />
      <mj-class name="footer-navbar" align="left" padding="0 25px" />
    </mj-attributes>
</mj-head>
</mjml>
